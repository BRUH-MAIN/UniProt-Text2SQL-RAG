# Google AI Studio API key (https://aistudio.google.com/apikey) - used by the agent.
GEMINI_API_KEY=

# Read-only Postgres connection string used by the deployed app.
# e.g. postgresql://app_readonly:PASSWORD@HOST/DBNAME?sslmode=require
# See docs/SETUP.md for how to provision this role.
DATABASE_URL=

# Full-privilege Postgres connection string, used ONLY by db/init_db.py and
# the ingest/ scripts. Never used by app.py, never set as an HF Space secret.
INGEST_DATABASE_URL=

# Optional: cap how many UniProt records ingest/parse_and_load.py loads.
INGEST_LIMIT=12000

# Required by app.py: the Gemini model the agent uses. Use a PINNED version id, never a
# "*-latest" alias (an alias changes under you, so behaviour and any evaluation of it drift).
# Check which models have free-tier quota on your account:
#   python -c "from google import genai; print([m.name for m in genai.Client().models.list()])"
# evaluation/RESULTS.md lists the models that were actually measured.
GEMINI_MODEL=

# Optional: demo cost guard (requests per hour, per client and across all clients).
# RATE_PER_CLIENT=15
# RATE_GLOBAL=150
